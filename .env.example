# ============================================================
# 初痕 记忆引擎 — 环境变量配置
# 复制此文件为 .env 后按需修改
# ============================================================

# ── Embedding 模型（Ollama 本地推理）──
# 必装：ollama pull bge-m3
OLLAMA_EMBED_MODEL=bge-m3

# CPU 线程数（可选，默认为 4）
OLLAMA_NUM_THREADS=4

# Ollama 服务地址（Docker 内用 http://ollama:11434）
LOCAL_LLM_OLLAMA_URL=http://localhost:11434

# ── LLM API（文本生成 & 工作记忆摘要）──
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── 本地 LLM（Ollama 摘要生成，可选）──
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_MODEL=qwen2.5:7b
# LOCAL_LLM_TIMEOUT=30

# ── 博查搜索 API（联网搜索，可选）──
# BOCHA_API_KEY=

# ── 数据目录 ──
# DATA_DIR=./data

# ── 多用户认证（JSON 格式，可选）──
# USERS={"admin":"changeme","user2":"password2"}

# ── 部署模式 full / lite ──
# DEPLOY_MODE=full

# ── Debug ──
# DEBUG_INCLUDE_PROMPT=false

# ── 冲动系统（主动开口）──
# IMPULSE_ACTIVE_PATH_B=true

# ── Docker 专用 ──
# OLLAMA_MODELS=/path/to/models
