# ============================================================
# 初痕 记忆引擎 — 环境变量配置
# 复制此文件为 .env 后按需修改
# ============================================================

# ── 存储后端：Qdrant（唯一后端）──
# QDRANT_URL 留空 = 本地嵌入式文件模式（data/qdrant）
# 设为 http(s):// = 连接 Qdrant 服务器（docker-compose 默认注入）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Embedding 提供者 ──
# vllm = 新后端 (Phase 1+), ollama = 回退
EMBED_PROVIDER=ollama
VLLM_EMBED_URL=http://localhost:8001
VLLM_EMBED_MODEL=BAAI/bge-m3
VLLM_EMBED_TIMEOUT=30

# ── 本地 LLM (摘要/实体抽取) ──
VLLM_CHAT_URL=http://localhost:8002
VLLM_CHAT_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_CHAT_TIMEOUT=60

# ── Embedding 模型（Ollama 本地推理，回退用）──
# 必装：ollama pull bge-m3
OLLAMA_EMBED_MODEL=bge-m3

# CPU 线程数（可选，默认为 4）
OLLAMA_NUM_THREADS=4

# Ollama 服务地址（Docker 内用 http://ollama:11434）
LOCAL_LLM_OLLAMA_URL=http://localhost:11434

# ── LLM API（文本生成 & 工作记忆摘要）──
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── 本地 LLM（Ollama 摘要生成，可选）──
# LOCAL_LLM_ENABLED=true
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# LOCAL_LLM_TIMEOUT=30

# ── 博查搜索 API（联网搜索，可选）──
# BOCHA_API_KEY=

# ── 数据目录 ──
# DATA_DIR=./data

# ── 多用户认证（JSON 格式，可选）──
# USERS={"admin":"changeme","user2":"password2"}

# ── 部署模式 full / lite ──
# DEPLOY_MODE=full

# ── Debug ──
# DEBUG_INCLUDE_PROMPT=false

# ── 冲动系统（主动开口）──
# IMPULSE_ACTIVE_PATH_B=true

# ── Docker 专用 ──
# OLLAMA_MODELS=/path/to/models

# ── Qdrant 量化 (Phase 4 启用) ──
# QDRANT_ON_DISK=true
# QDRANT_QUANTIZATION=
# QDRANT_HNSW_M=16
# QDRANT_HNSW_EF_CONSTRUCT=100
# QDRANT_HNSW_EF=64
